POSTGRES_PASSWORD=change-me-with-a-long-random-password
ADMIN_API_KEY=change-me-with-a-separate-long-random-key
WEB_PORT=8080
CORS_ORIGINS=https://travel.example.com
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=VelaMuslimTravel/0.1 (+https://github.com/swansook-cyber/Vela-Muslim-Travel)
GEOCODING_CACHE_TTL_SECONDS=86400
GEOCODING_CACHE_MAX_ENTRIES=256
GEOCODING_MIN_INTERVAL_SECONDS=1.1
ROUTING_CACHE_TTL_SECONDS=300
ROUTING_CACHE_MAX_ENTRIES=256
ROUTING_MIN_INTERVAL_SECONDS=0.25
ROUTING_USER_AGENT=VelaMuslimTravel/0.1 (+https://github.com/swansook-cyber/Vela-Muslim-Travel)
ALLOW_TEST_FIXTURES=false
